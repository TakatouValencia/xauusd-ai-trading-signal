# Masukkan Discord Webhook URL Anda di sini:
# Contoh: DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdef...
DISCORD_WEBHOOK_URL=

# Mode Eksekusi Order: MARKET (Eksekusi Instan saat Candle M15 Close) atau LIMIT (Pending Order Retest)
ENTRY_MODE=MARKET
LIMIT_PULLBACK_PIPS=5.0

# Proteksi Risiko: Otomatis berhenti trading hari itu jika terkena X loss beruntun, lanjut besok
ENABLE_CIRCUIT_BREAKER=true
MAX_CONSECUTIVE_LOSSES_PER_DAY=3


